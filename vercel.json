    { "source": "/api/admin/packages", "destination": "/api/admin" },
    { "source": "/api/client/login", "destination": "/api/client" },
    { "source": "/api/client/register", "destination": "/api/client" },
    { "source": "/api/client/me", "destination": "/api/client" },
    { "source": "/api/client/account-summary", "destination": "/api/client" },
    { "source": "/api/client/forgot-password", "destination": "/api/client" },
    { "source": "/api/client/send-otp", "destination": "/api/client" },
