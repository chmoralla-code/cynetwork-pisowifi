{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/submit-order", "destination": "/api/orders" },
    { "source": "/api/track-order", "destination": "/api/orders" },
    { "source": "/admin", "destination": "/public/admin/index.html" },
    { "source": "/admin/login", "destination": "/public/admin/login.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
