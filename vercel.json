{
  "version": 2,
  "rewrites": [
    { "source": "/api/submit-order", "destination": "/api/orders" },
    { "source": "/api/track-order", "destination": "/api/orders" },
    { "source": "/api/admin/stats", "destination": "/api/admin" },
    { "source": "/api/admin/juanfi", "destination": "/api/admin" },
    { "source": "/api/admin/clients", "destination": "/api/admin" },
    { "source": "/api/admin/chats", "destination": "/api/admin" },
